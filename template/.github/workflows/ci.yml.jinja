name: CI

on:
  pull_request:
  push:
    branches: [main]
    tags: ['v[0-9]+.[0-9]+.[0-9]+']

jobs:

  test:
{% raw %}
    runs-on: ${{matrix.os}}
{% endraw %}
    strategy:
      matrix:
        python-version: {{python_versions+pypy_versions}}
{% raw %}
        os: [ubuntu-latest, windows-latest, macos-14]
        lowest_resolution: [false]
        is_insider:
        - ${{contains(github.repository, '-insiders/')}}

        exclude:
        - is_insider: true
          os: windows-latest
        - is_insider: true
          os: macos-14

{% endraw %}{% for v in python_versions[1:-1]+pypy_versions %}
        - os: macos-14
          python-version: '{{v}}'
        - os: windows-latest
          python-version: '{{v}}'
{% endfor %}
        include:
        - os: ubuntu-latest
          python-version: '{{python_versions[0]}}'
          lowest_resolution: true
        - os: ubuntu-latest
          python-version: '{{python_versions[-1]}}'
          lowest_resolution: true
{% raw %}

    env:
      TOP: ${{github.workspace}}
      COVERAGE_PROCESS_START: ${{github.workspace}}/pyproject.toml
    steps:
    - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
    - uses: ./.github/actions/setup
      with:
        python-version: ${{matrix.python-version}}

    - name: Resolve lowest direct dependencies
      if: matrix.lowest_resolution
      run: |
        uv lock --upgrade --resolution lowest-direct
        uv sync --locked --resolution lowest-direct
        uv pip install coverage pytest pytest-xdist

    - name: Test locked dependencies
      if: ${{ !matrix.lowest_resolution }}
      run: uv run --locked --with coverage --with pytest --with pytest-xdist -m ${{ matrix.os == 'ubuntu-latest' && 'coverage run -m' || '' }} pytest -n=auto -vv

    - name: Test lowest direct dependencies
      if: matrix.lowest_resolution
      run: uv run --no-sync -m coverage run -m pytest -n=auto -vv

    - run: |
        uv run ${{ matrix.lowest_resolution && '--no-sync' || '--with coverage' }} -m coverage combine
        mv .coverage .coverage.${{ matrix.python-version }}-${{matrix.os}}-${{strategy.job-index}}
      if: matrix.os == 'ubuntu-latest'

    - name: Upload coverage data
      uses: actions/upload-artifact@4cec3d8aa04e39d1a68397de0c4cd6fb9dce8ec1 # v4.6.1
      if: matrix.os == 'ubuntu-latest'
      with:
        name: coverage-data-${{github.run_id}}-${{ matrix.python-version }}-${{matrix.os}}-${{strategy.job-index}}
        path: .coverage.*
        include-hidden-files: true
        if-no-files-found: ignore

  coverage:
    name: Combine & check coverage
    env:
      TOP: ${{github.workspace}}
    if: always()
    needs: test
    runs-on: ubuntu-latest

    steps:
    - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
    - uses: ./.github/actions/setup

    - uses: actions/download-artifact@cc203385981b70ca67e1cc392babf9cc229d5806 # v4.1.9
      with:
        pattern: coverage-data-${{github.run_id}}-*
        merge-multiple: true

    - name: Combine coverage & fail if it's <100%
      run: |
        uv run --with coverage coverage combine
        uv run --with coverage coverage html --skip-covered --skip-empty

        # Report and write to summary.
        uv run --with coverage coverage report --format=markdown >> $GITHUB_STEP_SUMMARY

        # Report again and fail if under 100%.
{% endraw %}        uv run --with coverage coverage report{% if full_coverage %} --fail-under=100{% endif %}
{% raw %}

    - name: Upload HTML report if check failed
      uses: actions/upload-artifact@4cec3d8aa04e39d1a68397de0c4cd6fb9dce8ec1 # v4.6.1
      with:
        name: html-report
        path: htmlcov
      if: ${{ failure() }}


  publish:
    name: Publish new release
    runs-on: ubuntu-latest
    needs: [test, coverage]
    if: "startsWith(github.ref, 'refs/tags/v') && !contains(github.repository, '-insiders/')"
    environment: pypi
    permissions:
      # IMPORTANT: this permission is mandatory for Trusted Publishing
      id-token: write
      # this permission is mandatory to create github releases
      contents: write

    steps:
    - name: Checkout main
      uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
      with:
        fetch-depth: 0
    - uses: ./.github/actions/setup

    - name: build package
      run: uvx hatch build

    - name: Publish package distributions to PyPI
      uses: pypa/gh-action-pypi-publish@76f52bc884231f62b9a034ebfe128415bbaabdfc # v1.12.4

    - name: create github release
      env:
        GH_TOKEN: ${{ github.token }}
      run: gh release create "$GITHUB_REF_NAME" --verify-tag --generate-notes
{%- endraw %}
